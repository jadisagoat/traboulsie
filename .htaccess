Options -Indexes

# files that must never be downloaded: logs, database dumps, backups
<FilesMatch "(^error_log$|\.(log|sql|bak|old|tgz|gz|env|ini)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # one address for Google: https and without www (the SSL certificate is active)
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # sitemap.xml and robots.txt are built by the site (controllers/seo.php)
    RewriteRule ^(sitemap\.xml|robots\.txt)$ index.php/$1 [L]

    # internal folders
    RewriteRule ^(docs|application|system)(/|$) - [F,L]

    # Send every request that isn't a real file or folder to CodeIgniter
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>
